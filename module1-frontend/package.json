{
  "name": "saiv-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:instructor": "NEXT_PUBLIC_APP_SURFACE=instructor next dev -p 8501",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "start:instructor": "NEXT_PUBLIC_APP_SURFACE=instructor next start -p 8501",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jsqr": "1.4.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "autoprefixer": "^10.4.17",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
